# ============================================================
#  Auth Manager v3 — Environment Variables
#  Скопируйте в .env и заполните перед запуском
# ============================================================

# ── Database ──────────────────────────────────────────────────────────────────
# Локально:
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/auth_db
# Docker Compose (автоматически подставляется):
# DATABASE_URL=postgresql://postgres:postgres@db:5432/auth_db
# Облако (Railway / Render / Supabase):
# DATABASE_URL=postgresql://user:pass@host:5432/dbname?sslmode=require

# ── Security ──────────────────────────────────────────────────────────────────
# ОБЯЗАТЕЛЬНО замените на случайную строку (32+ символов):
# python -c "import secrets; print(secrets.token_hex(32))"
SECRET_SALT=REPLACE_WITH_RANDOM_64_CHAR_HEX_STRING

# Время жизни access token (часы)
ACCESS_TOKEN_EXPIRE_HOURS=24

# Время жизни ссылки сброса пароля (минуты)
PASSWORD_RESET_EXPIRE_MINUTES=60

# ── Password Policy ───────────────────────────────────────────────────────────
PASSWORD_MIN_LENGTH=8
PASSWORD_REQUIRE_UPPER=false
PASSWORD_REQUIRE_SPECIAL=false
PASSWORD_EXPIRE_DAYS=0

# ── SMTP Email ────────────────────────────────────────────────────────────────
# false = логировать в консоль (режим разработки)
SMTP_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@gmail.com
SMTP_PASSWORD=your-app-password-here
SMTP_FROM=noreply@your-domain.com

# ── Application ───────────────────────────────────────────────────────────────
# URL фронтенда (используется в ссылках писем)
FRONTEND_URL=http://localhost:3000

# Email администратора для системных уведомлений
ADMIN_EMAIL=admin@example.com

# ── Cloud / Production ────────────────────────────────────────────────────────
# Для production обязательно:
# FRONTEND_URL=https://your-domain.com
# SECRET_SALT=<64-char-random-hex>
# SMTP_ENABLED=true
# DATABASE_URL=postgresql://...?sslmode=require
